# Shared Hotpot admin token used by the dashboard collector to read each protected instance.
# Set either the value directly or the *_FILE variant. *_FILE takes precedence.
HOTPOT_ADMIN_TOKEN=REPLACE_WITH_THE_SAME_TOKEN_USED_BY_HOTPOT
# HOTPOT_ADMIN_TOKEN_FILE=/run/secrets/hotpot_admin_token

# Separate password required to view the centralized dashboard.
# Browsers still use HTTP Basic auth initially; username "hotpot" is recommended.
# The dashboard then issues a signed, expiring session for CSRF-protected actions.
HOTPOT_DASHBOARD_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_TOKEN
# HOTPOT_DASHBOARD_TOKEN_FILE=/run/secrets/dashboard_token

# Optional separate signing secret for dashboard sessions. If omitted, Hotpot derives
# a domain-separated signing key from HOTPOT_DASHBOARD_TOKEN.
# HOTPOT_DASHBOARD_SESSION_SECRET=
# HOTPOT_DASHBOARD_SESSION_SECRET_FILE=/run/secrets/dashboard_session_secret
HOTPOT_DASHBOARD_SESSION_TIMEOUT_SECONDS=3600
HOTPOT_DASHBOARD_ACTION_RATE_LIMIT_PER_MINUTE=30
# Set true only when the dashboard itself is always reached over HTTPS.
HOTPOT_DASHBOARD_COOKIE_SECURE=false

# Dashboard listener. With host networking, keep this on loopback and publish through Cloudflare Tunnel/Access if desired.
HOTPOT_DASHBOARD_BIND=127.0.0.1
HOTPOT_DASHBOARD_PORT=19090
HOTPOT_DASHBOARD_REFRESH_SECONDS=15
HOTPOT_DASHBOARD_TIMEOUT=5

# Persistent central intelligence database location inside the dashboard container.
HOTPOT_DASHBOARD_DATA_DIR=/data

# Raw central event retention and SQLite housekeeping. Lifetime attacker rollups are
# retained after raw events expire.
HOTPOT_DASHBOARD_EVENT_RETENTION_DAYS=90
HOTPOT_DASHBOARD_HOUSEKEEPING_INTERVAL_HOURS=6

# SQLite integrity / disk monitoring and online backups. An online backup is made
# before store constructors perform schema migrations when an existing DB is present.
HOTPOT_DASHBOARD_PRE_MIGRATION_BACKUP=true
HOTPOT_DASHBOARD_BACKUPS_ENABLED=true
HOTPOT_DASHBOARD_BACKUP_INTERVAL_HOURS=24
HOTPOT_DASHBOARD_BACKUP_KEEP=7
HOTPOT_DASHBOARD_STORAGE_CHECK_SECONDS=900
HOTPOT_DASHBOARD_DISK_WARN_FREE_GB=2
HOTPOT_DASHBOARD_DISK_CRITICAL_FREE_MB=512
HOTPOT_DASHBOARD_DB_WARN_MB=1024

# Maximum event pages pulled from each Hotpot per refresh cycle.
HOTPOT_DASHBOARD_MAX_EVENT_PAGES=20

# Central policy control plane. The dashboard persists policy in dashboard.sqlite3
# and reconciles a revisioned last-known-good snapshot to each Hotpot /data volume.
# Environment HOTPOT_ALLOW_CIDRS remains an independent bootstrap/emergency allowlist.
# Manual Reconcile in the Policy tab ignores this interval and runs immediately.
HOTPOT_DASHBOARD_POLICY_RECONCILE_SECONDS=60

# Deployment/upgrade planning. These settings only generate the read-only plan shown
# in the Deployment tab; the dashboard never receives Docker socket access.
# The QNAP helper passes HOTPOT_IMAGE_TAG to Compose. Prefer an immutable Docker tag
# for controlled production rollout/rollback; latest is supported but mutable.
HOTPOT_DASHBOARD_COMPOSE_FILE=/share/Data/config/cloudflared/docker-compose.yml
HOTPOT_DASHBOARD_DEPLOY_TAG=latest
HOTPOT_DASHBOARD_DEPLOY_SERVICES=hotpot-monkeyhead,hotpot-watersolver,hotpot-hvac,hotpot-tapmenu,hotpot-dashboard

# Optional local MaxMind databases. No external GeoIP API calls are made.
# Mount the directory read-only into the dashboard container (see compose examples).
# GeoLite2-ASN adds AS number/provider. GeoLite2-City adds country/city/location.
# GeoLite2-Country can be used instead of City if city-level data is not wanted.
# Network attribution is persisted with lifetime attacker history and refreshed in
# bounded batches when MaxMind database files change.
# Example paths after installing the databases under /geoip:
# HOTPOT_GEOIP_ASN_DB=/geoip/GeoLite2-ASN.mmdb
# HOTPOT_GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb
HOTPOT_GEOIP_ASN_DB=
HOTPOT_GEOIP_CITY_DB=
HOTPOT_GEOIP_COUNTRY_DB=
HOTPOT_DASHBOARD_GEOIP_ENRICH_BATCH=500

# Threat-response recommendations. Recommendations never enforce automatically.
# A dashboard user must explicitly approve challenge/block actions.
# Actors older than STALE_MINUTES do not receive active recommendations.
HOTPOT_RESPONSE_ENABLED=true
HOTPOT_RESPONSE_ACTIVE_WINDOW_HOURS=24
HOTPOT_RESPONSE_STALE_MINUTES=360
HOTPOT_RESPONSE_RECOMMENDATION_TTL_HOURS=24
HOTPOT_RESPONSE_DISMISS_HOURS=24

# Optional Cloudflare enforcement. Keep disabled until the API token and every
# protected instance you want to enforce are mapped below. Approved rules are
# scoped to the configured hostnames, persisted in dashboard.sqlite3, and removed
# automatically when their recommendation duration expires.
# The API token should have Zone WAF Write for the listed zones. *_FILE takes precedence.
HOTPOT_CLOUDFLARE_ENFORCEMENT_ENABLED=false
HOTPOT_CLOUDFLARE_API_TOKEN=
# HOTPOT_CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_api_token
# Hotpot periodically reconciles against Cloudflare and verifies every mutation.
HOTPOT_CLOUDFLARE_RECONCILE_SECONDS=300
HOTPOT_CLOUDFLARE_RETRY_ATTEMPTS=3
HOTPOT_CLOUDFLARE_RETRY_BASE_SECONDS=0.25
# Keep this JSON on one line in env_file. Multiple instances may share a zone_id.
HOTPOT_CLOUDFLARE_TARGETS={"monkeyhead":{"zone_id":"REPLACE_MONKEYHEAD_ZONE_ID","hosts":["www.monkeyheadbrewing.com"]},"watersolver":{"zone_id":"REPLACE_WATERSOLVER_ZONE_ID","hosts":["brewwatersolver.com","www.brewwatersolver.com"]},"hvac":{"zone_id":"REPLACE_BYTEMELOSER_ZONE_ID","hosts":["hvac.bytemeloser.com"]},"tapmenu":{"zone_id":"REPLACE_BYTEMELOSER_ZONE_ID","hosts":["tapmenu.bytemeloser.com"]}}

# Dashboard notification center. Important events are always recorded locally in
# dashboard.sqlite3. External webhook/email delivery is opt-in with this switch.
# Routine L1/L2 probes are never sent as notifications.
HOTPOT_DASHBOARD_NOTIFICATIONS_ENABLED=false
HOTPOT_DASHBOARD_NOTIFY_RETRY_SECONDS=300
# Severity routing. Only configured/available channels are used. Empty means
# dashboard-only. Defaults: critical=webhook+email, warning=email, info=local only.
HOTPOT_DASHBOARD_NOTIFY_CRITICAL_CHANNELS=webhook,email
HOTPOT_DASHBOARD_NOTIFY_WARNING_CHANNELS=email
HOTPOT_DASHBOARD_NOTIFY_INFO_CHANNELS=

# Optional webhook delivery.
HOTPOT_DASHBOARD_NOTIFY_WEBHOOK_URL=
HOTPOT_DASHBOARD_NOTIFY_WEBHOOK_BEARER=
# HOTPOT_DASHBOARD_NOTIFY_WEBHOOK_BEARER_FILE=/run/secrets/dashboard_webhook_bearer

# Optional SMTP delivery. Configure FROM and at least one comma-separated TO address.
HOTPOT_DASHBOARD_SMTP_HOST=
HOTPOT_DASHBOARD_SMTP_PORT=587
HOTPOT_DASHBOARD_SMTP_STARTTLS=true
HOTPOT_DASHBOARD_SMTP_SSL=false
HOTPOT_DASHBOARD_SMTP_USERNAME=
HOTPOT_DASHBOARD_SMTP_PASSWORD=
# HOTPOT_DASHBOARD_SMTP_PASSWORD_FILE=/run/secrets/dashboard_smtp_password
HOTPOT_DASHBOARD_SMTP_FROM=
HOTPOT_DASHBOARD_SMTP_TO=

# JSON list of Hotpot instances to aggregate.
# Keep this on one line when used as an env_file value.
HOTPOT_DASHBOARD_INSTANCES=[{"id":"monkeyhead","name":"Monkey Head Brewing","url":"http://127.0.0.1:18088"},{"id":"watersolver","name":"Brew Water Solver","url":"http://127.0.0.1:12120"},{"id":"hvac","name":"HVAC","url":"http://127.0.0.1:18080"},{"id":"tapmenu","name":"Tap Menu","url":"http://127.0.0.1:18111"}]
