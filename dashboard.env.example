# Shared Hotpot admin token used by the dashboard collector to read each protected instance.
HOTPOT_ADMIN_TOKEN=REPLACE_WITH_THE_SAME_TOKEN_USED_BY_HOTPOT

# Separate password required to view the centralized dashboard.
# Browsers will prompt for HTTP Basic auth; use username "hotpot" and this value as the password.
HOTPOT_DASHBOARD_TOKEN=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_TOKEN

# Dashboard listener. With host networking, keep this on loopback and publish through Cloudflare Tunnel/Access if desired.
HOTPOT_DASHBOARD_BIND=127.0.0.1
HOTPOT_DASHBOARD_PORT=19090
HOTPOT_DASHBOARD_REFRESH_SECONDS=15
HOTPOT_DASHBOARD_TIMEOUT=5

# Persistent central intelligence database location inside the dashboard container.
HOTPOT_DASHBOARD_DATA_DIR=/data

# Raw central event retention and SQLite housekeeping. Lifetime attacker rollups are
# retained after raw events expire.
HOTPOT_DASHBOARD_EVENT_RETENTION_DAYS=90
HOTPOT_DASHBOARD_HOUSEKEEPING_INTERVAL_HOURS=6

# Maximum event pages pulled from each Hotpot per refresh cycle.
HOTPOT_DASHBOARD_MAX_EVENT_PAGES=20

# Optional local MaxMind databases. No external GeoIP API calls are made.
# Mount the directory read-only into the dashboard container (see compose examples).
# GeoLite2-ASN adds AS number/provider. GeoLite2-City adds country/city/location.
# GeoLite2-Country can be used instead of City if city-level data is not wanted.
# Network attribution is persisted with lifetime attacker history and refreshed in
# bounded batches when MaxMind database files change.
# Example paths after installing the databases under /geoip:
# HOTPOT_GEOIP_ASN_DB=/geoip/GeoLite2-ASN.mmdb
# HOTPOT_GEOIP_CITY_DB=/geoip/GeoLite2-City.mmdb
HOTPOT_GEOIP_ASN_DB=
HOTPOT_GEOIP_CITY_DB=
HOTPOT_GEOIP_COUNTRY_DB=
HOTPOT_DASHBOARD_GEOIP_ENRICH_BATCH=500

# Threat-response recommendations. This layer never performs enforcement; it only
# records watch/challenge/block recommendations for review in the dashboard.
# Actors older than STALE_MINUTES do not receive active recommendations.
HOTPOT_RESPONSE_ENABLED=true
HOTPOT_RESPONSE_ACTIVE_WINDOW_HOURS=24
HOTPOT_RESPONSE_STALE_MINUTES=360
HOTPOT_RESPONSE_RECOMMENDATION_TTL_HOURS=24
HOTPOT_RESPONSE_DISMISS_HOURS=24

# JSON list of Hotpot instances to aggregate.
# Keep this on one line when used as an env_file value.
HOTPOT_DASHBOARD_INSTANCES=[{"id":"monkeyhead","name":"Monkey Head Brewing","url":"http://127.0.0.1:18088"},{"id":"watersolver","name":"Brew Water Solver","url":"http://127.0.0.1:12120"},{"id":"hvac","name":"HVAC","url":"http://127.0.0.1:18080"},{"id":"tapmenu","name":"Tap Menu","url":"http://127.0.0.1:18111"}]
