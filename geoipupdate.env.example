# Automatic MaxMind GeoLite database updates.
# Copy this file to:
#   /share/Data/config/cloudflared/geoipupdate.env
# Then protect it because GEOIPUPDATE_LICENSE_KEY is a secret:
#   chmod 600 /share/Data/config/cloudflared/geoipupdate.env
#
# Create a MaxMind license key in your MaxMind account. Use a key that is only
# needed for GeoIP/GeoLite downloads; do not commit the real values to Git.
GEOIPUPDATE_ACCOUNT_ID=REPLACE_WITH_MAXMIND_ACCOUNT_ID
GEOIPUPDATE_LICENSE_KEY=REPLACE_WITH_MAXMIND_LICENSE_KEY

# Hotpot needs ASN/provider plus city/country enrichment.
GEOIPUPDATE_EDITION_IDS=GeoLite2-ASN GeoLite2-City

# Hours between update checks. GeoLite2 ASN is released on weekdays and City is
# released Tuesdays/Fridays, so checking every 24 hours keeps both reasonably fresh.
GEOIPUPDATE_FREQUENCY=24

# Must match the writable volume mounted by the Compose examples.
GEOIPUPDATE_DB_DIR=/usr/share/GeoIP

# Set to 1 temporarily when troubleshooting downloads.
GEOIPUPDATE_VERBOSE=0
