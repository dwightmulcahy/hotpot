# Shared Hotpot runtime configuration for QNAP / host-network deployments.
# Copy to an absolute path such as:
#   /share/Data/config/cloudflared/hotpot.env
#
# Per-instance HOTPOT_PORT, HOTPOT_UPSTREAM, HOTPOT_INSTANCE_ID, and
# HOTPOT_INSTANCE_NAME stay in compose.qnap.example.yml.

HOTPOT_BIND=127.0.0.1
HOTPOT_PROFILES=wordpress,secrets,git,php,generic

# cloudflared and Hotpot both use host networking, so the actual TCP peer is
# loopback. CF-Connecting-IP is honored only from these trusted addresses.
HOTPOT_CLIENT_IP_MODE=cloudflare
HOTPOT_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

HOTPOT_TARPIT_ENABLED=true
HOTPOT_TARPIT_MAX_CONCURRENT=10
HOTPOT_TARPIT_INITIAL_DELAY=1.0
HOTPOT_TARPIT_CHUNK_DELAY=2.0
HOTPOT_TARPIT_MAX_SECONDS=20
HOTPOT_TARPIT_ESCALATED_MAX_SECONDS=60

HOTPOT_RETENTION_DAYS=30
HOTPOT_ATTACKER_RETENTION_DAYS=90
HOTPOT_HOUSEKEEPING_INTERVAL_SECONDS=21600

HOTPOT_NOTIFY_MIN_LEVEL=3
HOTPOT_NOTIFY_COOLDOWN_SECONDS=3600

HOTPOT_NOTIFY_WEBHOOK_URL=
HOTPOT_NOTIFY_WEBHOOK_BEARER=

HOTPOT_SMTP_HOST=
HOTPOT_SMTP_PORT=587
HOTPOT_SMTP_STARTTLS=true
HOTPOT_SMTP_USERNAME=
HOTPOT_SMTP_PASSWORD=
HOTPOT_SMTP_FROM=
HOTPOT_SMTP_TO=

# Required for authenticated status/intelligence APIs and the centralized dashboard.
HOTPOT_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN

# Optional trusted clients that should bypass deception/tarpits.
HOTPOT_ALLOW_CIDRS=

# Plausible header used by Hotpot-generated responses instead of aiohttp/Python.
HOTPOT_SERVER_HEADER=nginx

TZ=America/Costa_Rica
