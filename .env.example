# Required by the sample compose file if you want admin endpoints.
# Generate with: openssl rand -hex 32
# Set either the value directly or the *_FILE variant. *_FILE takes precedence.
HOTPOT_ADMIN_TOKEN=
# HOTPOT_ADMIN_TOKEN_FILE=/run/secrets/hotpot_admin_token

# Trusted source addresses/networks that should bypass honeypot routing.
HOTPOT_ALLOW_CIDRS=

# HTTP Server header used by Hotpot-generated responses when the upstream does
# not provide its own. Avoid exposing Python/aiohttp implementation details.
HOTPOT_SERVER_HEADER=nginx

# Reverse-proxy behavior and request/body resource limits.
HOTPOT_PRESERVE_HOST=true
HOTPOT_MAX_REQUEST_BODY=8388608
HOTPOT_CLIENT_BODY_TIMEOUT_SECONDS=30
HOTPOT_MAX_UPSTREAM_CONCURRENT=128
HOTPOT_MAX_WEBSOCKETS=64
# Shared budget for unknown-length request bodies buffered before upstream forwarding.
HOTPOT_MAX_BUFFERED_BODY_BYTES=33554432
HOTPOT_RESOURCE_ACQUIRE_TIMEOUT_SECONDS=1

# Per-source persistence budget. Requests above this rate are still handled and
# deceived normally; only SQLite/JSONL/notification work is suppressed.
# Set HOTPOT_EVENT_RATE_LIMIT_PER_MINUTE=0 to disable persistence limiting.
HOTPOT_EVENT_RATE_LIMIT_PER_MINUTE=120
HOTPOT_EVENT_RATE_LIMIT_BURST=30
HOTPOT_EVENT_STATE_TTL_SECONDS=3600
HOTPOT_EVENT_MAX_SOURCES=10000

# IPverse crawler/monitor attribution. This is enrichment only: verified bots do
# not bypass deception or policy. Authoritative bot UAs outside their published
# ranges are marked spoofed and receive a small severity bonus.
HOTPOT_IPVERSE_ENABLED=true
HOTPOT_IPVERSE_REFRESH_HOURS=24
HOTPOT_IPVERSE_TIMEOUT_SECONDS=10
# HOTPOT_IPVERSE_CRAWLERS_URL=https://raw.githubusercontent.com/ipverse/bot-ip-blocks/master/crawlers.json
# HOTPOT_IPVERSE_MONITORING_URL=https://raw.githubusercontent.com/ipverse/bot-ip-blocks/master/monitoring.json

# Auxiliary JSONL/notification queue. SQLite intelligence remains synchronous and
# authoritative. JSONL work cannot consume the notification reserve, and failed
# security notifications are durably spooled under /data for retry.
HOTPOT_TELEMETRY_QUEUE_MAX=2048
HOTPOT_TELEMETRY_NOTIFY_RESERVE=128
HOTPOT_TELEMETRY_DRAIN_TIMEOUT_SECONDS=5
HOTPOT_NOTIFICATION_RETRY_SECONDS=60

# Upstream readiness checks.
HOTPOT_HEALTHCHECK_INTERVAL_SECONDS=30
HOTPOT_HEALTHCHECK_TIMEOUT_SECONDS=5

# Optional webhook notifications. Secret bearer supports *_FILE.
HOTPOT_NOTIFY_WEBHOOK_URL=
HOTPOT_NOTIFY_WEBHOOK_BEARER=
# HOTPOT_NOTIFY_WEBHOOK_BEARER_FILE=/run/secrets/hotpot_webhook_bearer

# Optional SMTP notifications. Password supports *_FILE.
HOTPOT_SMTP_HOST=
HOTPOT_SMTP_PORT=587
HOTPOT_SMTP_STARTTLS=true
HOTPOT_SMTP_USERNAME=
HOTPOT_SMTP_PASSWORD=
# HOTPOT_SMTP_PASSWORD_FILE=/run/secrets/hotpot_smtp_password
HOTPOT_SMTP_FROM=
HOTPOT_SMTP_TO=

# Client IP resolution. Use direct unless Hotpot is behind a trusted proxy.
HOTPOT_CLIENT_IP_MODE=direct
HOTPOT_TRUSTED_PROXY_CIDRS=

# For compose.cloudflare.example.yml
CLOUDFLARE_TUNNEL_TOKEN=
